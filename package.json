{
  "name": "codex-appearance-companion",
  "version": "0.3.0-alpha.3",
  "private": true,
  "description": "Unofficial Linux appearance companion for compatible Codex desktop installations",
  "scripts": {
    "start": "./launch.sh",
    "test": "node test/core.test.cjs && python3 -m unittest discover -s test -p 'test_*.py'",
    "install-desktop": "python3 scripts/install.py",
    "check": "node scripts/check.cjs",
    "format": "prettier --write src scripts/*.cjs test/*.cjs *.json *.md .github/**/*.yml",
    "format:check": "prettier --check src scripts/*.cjs test/*.cjs *.json *.md .github/**/*.yml",
    "doctor": "python3 scripts/doctor.py",
    "release:check": "python3 scripts/release.py --check",
    "release:build": "python3 scripts/release.py",
    "prepare-runtime": "python3 scripts/prepare.py"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
